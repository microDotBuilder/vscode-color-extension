{
  "name": "color-comment",
  "displayName": "Color Comment",
  "description": "Color comments with specific tags like i:, todo:, note:, etc.",
  "repository": "https://github.com/microDotBuilder/vscode-color-extension",
  "version": "0.0.1",
  "author": "microDotBuilder",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/v2/extension.js",
  "contributes": {
    "configuration": {
      "title": "Color Comment",
      "properties": {
        "colorComment.tagColors": {
          "type": "object",
          "description": "Tag-to-color mapping for comment highlighting",
          "scope": "resource",
          "additionalProperties": {
            "type": "string",
            "format": "color-hex"
          },
          "patternProperties": {
            "^[a-zA-Z0-9]+:$": {
              "type": "string",
              "format": "color-hex",
              "description": "Hex color code for the tag"
            }
          },
          "default": {
            "i:": "#ff6b6b",
            "todo:": "#ffa500",
            "note:": "#4dabf7",
            "fixme:": "#ff4757",
            "hack:": "#9c88ff",
            "warning:": "#ffd93d"
          }
        }
      }
    },
    "commands": [
      {
        "command": "colorComment.editSettings",
        "title": "Edit Color Comment Settings",
        "category": "Color Comment"
      },
      {
        "command": "colorComment.setup",
        "title": "Setup Color Comment Extension",
        "category": "Color Comment"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && webpack",
    "watch": "npm-run-all -p watch:*",
    "watch:webpack": "webpack --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "ci": "npm run test && npm run pretest",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "ajv": "^7.2.4",
    "chai": "^5.2.0",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "sinon": "^21.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  }
}
